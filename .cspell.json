{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en-US,de-DE",
  "dictionaries": ["bash", "en-common-misspellings", "git", "node", "npm", "softwareTerms"],
  "files": ["**/{*,.*}/**/*.*"],
  "flagWords": [],
  "ignorePaths": [
    "**/.git/**",
    "**/.github/agents/**",
    "**/.github/prompts/**",
    "**/.github/skills/**",
    "**/.husky/**",
    "**/.vscode/**",
    "**/tests/fixtures/**",
    ".cspell.json",
    ".gitignore",
    "package-lock.json"
  ],
  "import": ["@cspell/dict-de-de/cspell-ext.json"],
  "loadDefaultConfiguration": true,
  "useGitignore": true,
  "ignoreWords": [
    "actionlint",
    "argjson",
    "claude",
    "dotclaude",
    "gsub",
    "jfandy1982",
    "pathspec",
    "sdlc",
    "startswith",
    "tonumber",
    "worktrees"
  ],
  "words": []
}
